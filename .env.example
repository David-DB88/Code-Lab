# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored via `*.local` and will never be committed.

# Web3Forms — get from https://web3forms.com after registering your email.
VITE_WEB3FORMS_ACCESS_KEY=

# Telegram bot — create via @BotFather, then send your bot a message and find
# the chat ID via https://api.telegram.org/bot<TOKEN>/getUpdates
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
